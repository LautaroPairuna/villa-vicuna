// Prisma 7 — usa driver adapters (engine "client") con MySQL/MariaDB.
// La conexión se inyecta en código vía @prisma/adapter-mariadb (ver src/lib/prisma.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ── Autenticación (NextAuth / Credentials) ──────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Biblioteca de medios ────────────────────────────────────────────
model Media {
  id        String   @id @default(cuid())
  path      String   // ruta pública servida desde el volumen, p.ej. /uploads/rooms/twin-1.webp
  alt       String   @default("")
  width     Int?
  height    Int?
  mime      String?
  size      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomCovers    Room[]         @relation("RoomCover")
  reviewCovers  Review[]       @relation("ReviewCover")
  promotionCovers Promotion[]
  saltaPlaceCovers SaltaPlace[]
  roomImages    RoomImage[]
  reviewImages  ReviewImage[]
  sectionImages SectionImage[]
}

// ── Habitaciones (solo imágenes; los textos siguen en next-intl por `key`) ──
model Room {
  id        String      @id @default(cuid())
  key       String      @unique // coincide con la clave de traducción: twin_interna, matrimonial, ...
  categoria String              // standard | superior
  cantidad  String
  order     Int         @default(0)
  coverId   String?
  cover     Media?      @relation("RoomCover", fields: [coverId], references: [id])
  images    RoomImage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model RoomImage {
  id      String @id @default(cuid())
  roomId  String
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id])
  order   Int    @default(0)

  @@index([roomId])
  @@index([mediaId])
}

// ── Reseñas (solo imágenes) ─────────────────────────────────────────
model Review {
  id        String        @id @default(cuid())
  key       String        @unique // desayuno, detalles, personal
  order     Int           @default(0)
  coverId   String?
  cover     Media?        @relation("ReviewCover", fields: [coverId], references: [id])
  images    ReviewImage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaId  String
  media    Media  @relation(fields: [mediaId], references: [id])
  order    Int    @default(0)

  @@index([reviewId])
  @@index([mediaId])
}

// ── Imágenes sueltas de secciones (hero, nosotros, contacto, menú) ──
model SectionImage {
  id        String   @id @default(cuid())
  slug      String   @unique // hero_poster, nosotros, contactenos, menu_foods, menu_drinks
  mediaId   String?
  media     Media?   @relation(fields: [mediaId], references: [id])
  updatedAt DateTime @updatedAt
}

// ── Overrides de textos (next-intl) ─────────────────────────────────
// Guarda SOLO los textos editados desde el panel. El JSON sigue siendo el
// valor por defecto; estos overrides se mergean encima en i18n.ts.
model Translation {
  id        String   @id @default(cuid())
  locale    String   @db.VarChar(8) // es | en | fr
  key       String   @db.VarChar(191) // clave punteada, p.ej. "about_us.parrafo1"
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([locale, key])
  @@index([locale])
}

model Promotion {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String   @db.Text
  content        String   @db.Text
  coverId        String?
  cover          Media?   @relation(fields: [coverId], references: [id])
  ctaLabel       String?
  ctaHref        String?
  validFrom      DateTime?
  validTo        DateTime?
  seoTitle       String?
  seoDescription String?  @db.Text
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published])
  @@index([validFrom])
}

model SaltaPlace {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  category            String
  summary             String   @db.Text
  content             String   @db.Text
  coverId             String?
  cover               Media?   @relation(fields: [coverId], references: [id])
  address             String?  @db.Text
  mapsUrl             String?
  distanceFromHotel   String?
  recommendedDuration String?
  seoTitle            String?
  seoDescription      String?  @db.Text
  featured            Boolean  @default(false)
  published           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([category])
}
